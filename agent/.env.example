# Google Gemini API Key (for voice agent)
# Get yours from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# LiveKit Server Configuration
# For LiveKit Cloud: wss://your-project.livekit.cloud
# For local dev: ws://localhost:7880
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# SyncTalk Server Configuration
# URL of your SyncTalk server
SYNCTALK_SERVER_URL=http://localhost:5001

# SyncTalk Video Generation Settings
# FPS for generated video (default: 25)
SYNCTALK_FPS=25

# Starting frame index in the dataset (default: 0)
SYNCTALK_START_FRAME=0
